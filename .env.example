# ============================================================================
#  Mergerie — environment variables (all optional unless stated otherwise)
#
#  Copy this file to `.env` (loaded automatically at startup via
#  `--env-file-if-exists=.env`). Each variable is read as-is by the code;
#  boolean values are given as "1" (on) / "0" or absent.
#
#  NOTE — your GitLab and GitHub API tokens are NOT set here. They are entered
#  in Settings → Git and stored locally in SQLite (never returned in clear text).
#  The GitHub variables below concern the TLS of a GitHub Enterprise instance
#  and the authentication of the copilot CLI — two different things.
# ============================================================================

# ---------------------------------------------------------------------------
#  AI agent (the CLI that reviews / writes code)
# ---------------------------------------------------------------------------

# Agent binary, invoked as `<bin> [COPILOT_ARGS] -p "<prompt>"`.
# Default: "copilot". Set "claude" for Claude Code.
COPILOT_BIN=claude

# Arguments added BEFORE `-p` (space-separated). Depending on the binary:
#   claude  → --dangerously-skip-permissions   (the agent must be able to write files)
#   copilot → --yolo   (optionally --model claude-sonnet-5)
COPILOT_ARGS=--dangerously-skip-permissions
# copilot example:
# COPILOT_BIN=copilot
# COPILOT_ARGS=--yolo --model claude-sonnet-5

# Dry-run mode: "1" = no real call to the agent, a mock report/patch is
# generated (demo, dev, tests). ALSO enabled automatically when the binary above
# cannot be found. Default: 0.
COPILOT_DRY_RUN=0

# Maximum duration of ONE agent call, in milliseconds. Beyond that the call is
# killed and the error suggests retrying / raising this value. Default: 900000 (15 min).
COPILOT_TIMEOUT_MS=1800000   # 30 min

# Same, but for RESUMABLE SESSION calls (coding/review/convergence that keep their
# context). If absent, falls back to COPILOT_TIMEOUT_MS then to 900000.
# AGENT_SESSION_TIMEOUT_MS=1800000

# --- copilot only: authentication of resumable sessions ---
# Each copilot session runs in an isolated COPILOT_HOME; the app imports (symlinks)
# the auth from your usual copilot home into it. Set COPILOT_HOME only if copilot
# stores its config somewhere other than ~/.copilot. (claude does not need this.)
# COPILOT_HOME=/home/me/.copilot
# If importing the auth is not enough, provide a GitHub token (passed as-is to the
# agent — it authenticates the CLI, it is NOT the token Mergerie uses to reach the
# GitHub API). Any one of these three is enough:
# COPILOT_GITHUB_TOKEN=ghp_xxx
# GH_TOKEN=ghp_xxx
# GITHUB_TOKEN=ghp_xxx

# ---------------------------------------------------------------------------
#  Server
# ---------------------------------------------------------------------------

# HTTP port of the web server. Default: 4319.
PORT=4319

# Listening interface. Default: 127.0.0.1 (localhost ONLY, not reachable from the
# network). `0.0.0.0` exposes the app on the network: it has NO authentication —
# reserve that for a trusted network. See README § Security.
# HOST=127.0.0.1

# Data directory (SQLite database, clones, reports, sessions…). Default: ./data.
# Useful to isolate several instances (the demo uses data-demo/).
# MERGERIE_DATA_DIR=./data

# Demo mode: "1" = "mock data" banner + static Git dataset, without any real
# connection. Normally set by `npm run demo`. Default: 0.
# MERGERIE_DEMO=0

# ---------------------------------------------------------------------------
#  Docker (Docker tab)
# ---------------------------------------------------------------------------

# Path to the `docker` binary if the SERVER's PATH cannot find it (it may work in your
# shell but not in the Node process started from a GUI/systemd/reduced PATH). Default:
# "docker" (looked up in PATH, with an automatic fallback to the usual Mac/WSL/Linux
# locations). Use the output of `which docker`.
# DOCKER_BIN=/usr/local/bin/docker

# ---------------------------------------------------------------------------
#  Git — cloning
# ---------------------------------------------------------------------------

# "1" = clone over SSH (https URLs are converted to git@…), using your own key for
# both forges. Otherwise clones over HTTPS with the token of the repository's forge
# (GitLab or GitHub). Default: 0 (HTTPS). Set 1 if you authenticate with an SSH key.
GIT_CLONE_SSH=1

# ---------------------------------------------------------------------------
#  Self-hosted forges — TLS (corporate certificate)
#
#  The two forges are configured INDEPENDENTLY: pinning the CA of your internal
#  GitLab changes nothing for calls to github.com, and vice versa.
# ---------------------------------------------------------------------------

# Path to the internal CA (PEM) used to validate the certificate of a self-hosted
# GitLab. Recommended when facing a corporate certificate unknown to Node (applied
# to API requests AND to git commands).
# GITLAB_CA_CERT=/path/to/corporate-ca.pem

# "1" = DISABLES TLS verification (GitLab requests + git). Troubleshooting only —
# prefer GITLAB_CA_CERT. Default: 0.
# GITLAB_INSECURE_TLS=0

# Same for a GitHub Enterprise instance behind an internal CA. Only affects requests
# to the GitHub API.
# GITHUB_CA_CERT=/path/to/corporate-ca.pem
# GITHUB_INSECURE_TLS=0

# ---------------------------------------------------------------------------
#  Development / CI (not for normal runs)
# ---------------------------------------------------------------------------

# "1" = makes the i18n check (`npm run check`) fail on hardcoded French.
# I18N_STRICT=0

# Port used by the demo recorder (`npm run record:demo`) when the default port is
# already taken. Default: 4319.
# DEMO_PORT=4321

# Repository URL shown on the closing card of the recorded demo video.
# Default: github.com/debugall/mergerie.
# REPO_URL=gitlab.com/amady/mergerie

# Note: XDG_CONFIG_HOME is read automatically (system) as a fallback to locate the
# copilot home when importing its auth — do not set it here.
